{
  "name": "Inbox triage (Gmail → Claude → labels, drafts, Slack)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ]
        },
        "options": {}
      },
      "id": "d9c7e576-1bf2-4450-a082-30495f09201f",
      "name": "New email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "claude-haiku-4-5"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Classify this email for a small business inbox. Reply with JSON only, no prose:\n{\"category\": \"sales_lead\" | \"support\" | \"invoice\" | \"spam\" | \"other\",\n \"urgency\": \"high\" | \"normal\" | \"low\",\n \"summary\": \"one sentence\",\n \"suggested_reply\": \"a short reply in the sender's language, or empty string if none is needed\"}\n\nFrom: {{ $json.from.value[0].address }}\nSubject: {{ $json.subject }}\nBody:\n{{ $json.text ? $json.text.slice(0, 4000) : '' }}"
            }
          ]
        },
        "options": {
          "maxTokens": 400,
          "temperature": 0
        }
      },
      "id": "09304346-85ce-4d97-a22a-bce288157e9d",
      "name": "Classify with Claude",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\nconst start = raw.indexOf('{'); const end = raw.lastIndexOf('}');\nlet parsed;\ntry { parsed = JSON.parse(raw.slice(start, end + 1)); }\ncatch (e) { parsed = { category: 'other', urgency: 'normal', summary: 'could not classify', suggested_reply: '' }; }\nconst mail = $('New email').first().json;\nreturn [{ json: { ...parsed, messageId: mail.id, threadId: mail.threadId, from: mail.from.value[0].address, subject: mail.subject } }];"
      },
      "id": "3e8b46ac-d9e2-46ba-86cf-a5cfcddc1106",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "sales_lead",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "lead"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "support",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "support"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "spam",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "spam"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "dec9480e-cbe2-430c-9328-f4446173e2ad",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        780,
        300
      ]
    },
