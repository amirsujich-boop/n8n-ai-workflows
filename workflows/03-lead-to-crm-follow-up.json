        1560,
        200
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#leads"
        },
        "text": "=🔥 {{ $json.score }}/10 — {{ $json.name }} ({{ $json.company }})\n{{ $json.reason }}\nFirst reply sent. Follow up by phone today.",
        "otherOptions": {}
      },
      "id": "3521e240-acc3-4465-8c72-0e8bfb4b1eb4",
